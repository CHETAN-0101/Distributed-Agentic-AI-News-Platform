# =============================================================================
# AgentOS — Environment Configuration
# Copy this to .env and fill in real values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# PLATFORM
# -----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-64-char-random-string
TENANT_DEFAULT=default

# -----------------------------------------------------------------------------
# POSTGRESQL
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentos
POSTGRES_USER=agentos
POSTGRES_PASSWORD=agentos_dev_password
DATABASE_URL=postgresql+asyncpg://agentos:agentos_dev_password@localhost:5432/agentos

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# RABBITMQ
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=agentos
RABBITMQ_PASSWORD=agentos_dev_password
RABBITMQ_VHOST=/
RABBITMQ_URL=amqp://agentos:agentos_dev_password@localhost:5672/

# -----------------------------------------------------------------------------
# LLM PROVIDERS
# Provider priority: mistral > openai > ollama
# Set PROVIDER=mistral|openai|ollama
# -----------------------------------------------------------------------------
LLM_PROVIDER=mistral

# Mistral AI
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-large-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# OpenAI (fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Ollama (local fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Embedding model
EMBEDDING_PROVIDER=mistral
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIM=1024

# -----------------------------------------------------------------------------
# SERVICES — Internal URLs (within Docker network use service names)
# -----------------------------------------------------------------------------
API_GATEWAY_URL=http://localhost:8000
AGENT_REGISTRY_URL=http://localhost:8001
ORCHESTRATOR_URL=http://localhost:8002
WORKFLOW_SERVICE_URL=http://localhost:8003
MEMORY_SERVICE_URL=http://localhost:8004
EVIDENCE_SERVICE_URL=http://localhost:8005
VERIFICATION_SERVICE_URL=http://localhost:8006
POLICY_SERVICE_URL=http://localhost:8007
APPROVAL_SERVICE_URL=http://localhost:8008
EVALUATION_SERVICE_URL=http://localhost:8009
NOTIFICATION_SERVICE_URL=http://localhost:8010

# -----------------------------------------------------------------------------
# OBSERVABILITY
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=agentos
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
PROMETHEUS_PORT=9090

# -----------------------------------------------------------------------------
# NEWS INGESTION
# -----------------------------------------------------------------------------
NEWS_INGESTION_INTERVAL_SECONDS=300
NEWS_SOURCES_CONFIG=./infrastructure/newsflow/sources.yaml
GNEWS_API_KEY=
NEWSDATA_API_KEY=

# -----------------------------------------------------------------------------
# SECURITY
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# -----------------------------------------------------------------------------
# FRONTEND
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
